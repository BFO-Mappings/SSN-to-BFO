@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix ex: <https://example.org/property-chain-mapping-fixture/> .

# Synthetic regression-test fixture for active property-chain mappings.
# This is not source example data and is not an authoritative W3C example.
# It exists only to exercise named-property chains discovered from SSN2BFO.ttl
# in tools/test_elk_instance_mapping_entailments.py.

# Expected local property-chain assertion:
# ex:sample-source sosa:hasSample ex:sample .
ex:sample-source
    cco:ont00001873 ex:has-sample-step .

ex:has-sample-step
    bfo:BFO_0000084 ex:sample .

# Expected local property-chain assertion:
