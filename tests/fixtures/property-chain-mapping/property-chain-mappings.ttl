ex:is-hosted-by-step-1
    bfo:BFO_0000055 ex:is-hosted-by-step-2 .

ex:is-hosted-by-step-2
    bfo:BFO_0000197 ex:host-platform .

# Expected local property-chain assertion:
# ex:sample sosa:isSampleOf ex:sampled-feature .
ex:sample
