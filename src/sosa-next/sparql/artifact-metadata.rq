PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?ontology ?violation WHERE {
  VALUES ?ontology {
    <http://www.sks.ai/SSN2BFO/development/sosa-next/integrated>
    <http://www.sks.ai/SSN2BFO/development/sosa-next/bfo-mapping>
    <http://www.sks.ai/SSN2BFO/development/sosa-next/cco-extension>
    <http://www.sks.ai/SSN2BFO/development/sosa-next/edit>
  }
  {
    FILTER NOT EXISTS { ?ontology a owl:Ontology . }
    BIND("Missing owl:Ontology declaration." AS ?violation)
  }
  UNION
  {
    FILTER NOT EXISTS { ?ontology rdfs:label ?label . }
    BIND("Missing rdfs:label." AS ?violation)
  }
  UNION
  {
    FILTER(
      !STRSTARTS(
        STR(?ontology),
        "http://www.sks.ai/SSN2BFO/development/sosa-next/"
      )
    )
    BIND(
      "Ontology IRI is outside the expected forthcoming SOSA-only base."
      AS ?violation
    )
  }
  UNION
  {
    ?ontology owl:versionInfo ?versionInfo .
    FILTER(STRLEN(STR(?versionInfo)) = 0)
    BIND("Empty owl:versionInfo." AS ?violation)
  }
  UNION
  {
    ?ontology owl:versionIRI ?versionIRI .
    FILTER(!isIRI(?versionIRI))
    BIND("owl:versionIRI must be an IRI." AS ?violation)
  }
}
ORDER BY ?ontology ?violation
